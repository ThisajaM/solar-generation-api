PORT=3000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/slsea_solar?retryWrites=true&w=majority
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/slsea_solar_test
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
# Public Bearer-token API testing; cookies/credentialed CORS are disabled.
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Explicit opt-in: seed deletes and replaces the six domain collections.
SEED_CONFIRM=no
# Optional fixed window end for reproducible demo measurements.
SEED_END=2026-09-26T18:15:00Z

# Measurement quality policy (seconds; positive integers).
READING_FRESHNESS_SECONDS=1800
READING_INTERVAL_SECONDS=900
